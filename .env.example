# Центральный сервер: разные случайные admin- и query-токены (openssl rand -hex 32).
LOGNARA_CORE_QUERY_TOKEN=
LOGNARA_CORE_ADMIN_TOKEN=

# Общий тег образов core/relay/dock: master или sha-<полный SHA коммита>.
LOGNARA_IMAGE_TAG=master

# Пусто = Docker volume; абсолютный путь = каталог на хосте.
LOGNARA_CORE_DATA=
# Query-токен для отдельного compose dock, равен LOGNARA_CORE_QUERY_TOKEN.
LOGNARA_QUERY_TOKEN=

# Машина с приложениями: создайте relay и агента в dock, сохраните выданные токены.
LOGNARA_RELAY_CORE_TOKEN=
LOGNARA_AGENT_TOKEN=
# Общий RAM relay в MiB, минимум 2048; также задаёт mem_limit контейнера.
LOGNARA_RELAY_MEMORY_MB=2048
LOGNARA_RELAY_DATA=
LOGNARA_AGENT_DATA=
