# Общий ключ для agent -> relay. Сгенерируйте: openssl rand -hex 32
# Скопируйте файл в .env и задайте одинаковый ключ relay и всем агентам.
LOGNARA_RELAY_TOKEN=

# Ingest- и query-токены core. Должны различаться между собой и с ключом агентов.
LOGNARA_CORE_TOKEN=
LOGNARA_CORE_QUERY_TOKEN=

# Где хранить данные: пусто = Docker volume, абсолютный путь = папка на хосте.
LOGNARA_AGENT_DATA=
LOGNARA_RELAY_DATA=
LOGNARA_CORE_DATA=
