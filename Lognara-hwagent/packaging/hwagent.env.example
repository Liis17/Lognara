# /etc/lognara/hwagent.env, права 0600 root:root.
LOGNARA_CORE_URL=https://core.example.com/v1/batches
# Токен хоста из Dock (Доступ → Хост-агенты); показывается один раз.
LOGNARA_HOST_TOKEN=
# Необязательно: имя сервера (по умолчанию hostname) и окружение.
#LOGNARA_SERVER=mail-01
#LOGNARA_ENVIRONMENT=production
