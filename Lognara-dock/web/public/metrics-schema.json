{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lognara metrics bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "metrics"
  ],
  "properties": {
    "format": {
      "const": "lognara-metrics"
    },
    "version": {
      "const": 1
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "rule"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "title": {
            "type": "string",
            "maxLength": 128,
            "default": ""
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          },
          "unit": {
            "type": "string",
            "maxLength": 32,
            "default": ""
          },
          "kind": {
            "enum": [
              "delta",
              "cumulative",
              "gauge"
            ]
          },
          "aggregation": {
            "enum": [
              "sum",
              "avg",
              "min",
              "max",
              "last"
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "rule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contains",
              "pattern"
            ],
            "properties": {
              "environment": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128
              },
              "contains": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "pattern": {
                "type": "string",
                "maxLength": 4096
              },
              "value_group": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label_groups": {
                "type": "array",
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
